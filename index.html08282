<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080617"><title>GXRV DYNASTY — Premium Blox Fruits Trading Hub</title>
<style>
:root{--bg:#05070d;--p:#0b101a;--line:#2a1822;--txt:#f4f5f8;--muted:#9ca3b1;--red:#ff1744;--red2:#b3002d;--cyan:#ff4768;--blue:#ff1744}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 15% 0%,#310815 0,transparent 36%),radial-gradient(ellipse at 90% 28%,#21050d 0,transparent 34%),var(--bg);color:var(--txt);font:14px/1.5 Inter,system-ui,Arial,sans-serif;min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.12;background-image:linear-gradient(135deg,transparent 48%,#ff1744 49%,transparent 50%);background-size:80px 80px;mask-image:linear-gradient(to bottom,#000,transparent 65%)}
.wrap{max-width:1500px;margin:auto;padding:14px;position:relative}.head,.panel,.card{background:linear-gradient(145deg,rgba(17,19,29,.97),rgba(7,10,17,.98));border:1px solid var(--line);border-radius:12px;padding:17px;box-shadow:0 10px 30px #0005}.head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;border-color:#4d1021;box-shadow:0 0 24px #ff17440a}.brand{font-weight:1000;letter-spacing:1.4px;font-size:22px;color:#fff;text-shadow:0 0 18px #ff174455}.brand small{display:block;font-size:10px;color:#ff617e;letter-spacing:3px}.btn,nav button{background:#11151f;color:var(--txt);border:1px solid #30202a;padding:10px 13px;border-radius:8px;cursor:pointer;transition:.18s;font-weight:650}.btn:hover,nav button:hover{border-color:var(--red);transform:translateY(-1px);box-shadow:0 0 14px #ff174422}.primary{background:linear-gradient(110deg,#ff1744,#b90030);border:0;color:white;box-shadow:0 5px 18px #ff17442a}.nav{display:flex;gap:6px;overflow:auto;padding:12px 0;scrollbar-width:thin}.nav button{white-space:nowrap;font-size:12px}.nav button.active{background:linear-gradient(110deg,#a9082a,#f81743);border-color:#ff667f;color:white}.hero{display:grid;grid-template-columns:1.35fr .85fr;gap:14px;margin:14px 0}.hero>.panel:first-child{background:radial-gradient(ellipse at 100% 10%,#610d25aa,transparent 45%),linear-gradient(145deg,#11121b,#080910);min-height:300px;display:flex;flex-direction:column;justify-content:center}.hero h1{font-size:clamp(35px,5vw,68px);line-height:1.02;margin:12px 0;text-transform:uppercase;letter-spacing:-1.7px}.grad{background:linear-gradient(90deg,#fff,#ff1744,#ff8299);background-clip:text;color:transparent}.muted{color:var(--muted)}.eyebrow{color:#ff526f;font-size:11px;letter-spacing:3px;font-weight:900}.actions,.tools{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0}.section{display:none;animation:fade .2s ease}.section.active{display:block}@keyframes fade{from{opacity:.65;transform:translateY(3px)}to{opacity:1;transform:none}}.title{margin:22px 0 12px;font-size:24px;letter-spacing:-.4px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:14px;min-width:0;position:relative;overflow:hidden}.card:after{content:"";position:absolute;left:0;top:0;width:2px;height:100%;background:linear-gradient(transparent,#ff1744,transparent);opacity:.65}.art{height:100px;display:grid;place-items:center;font-size:48px;border-radius:9px;background:radial-gradient(circle at 50% 25%,#4a1223,#11111a 70%);border:1px solid #391321;margin-bottom:12px;text-shadow:0 0 18px #ff174477}.tag{display:inline-block;border:1px solid #5a1c2d;color:#ff9bad;background:#240b13;border-radius:999px;padding:3px 8px;font-size:11px}.value{color:#ff5b79;font-weight:900}.tools input,.tools select,.field input,.field textarea,.field select{background:#080b12;border:1px solid #33212a;border-radius:8px;padding:11px;color:var(--txt);min-width:0;outline:none}.tools input:focus,.field input:focus,.field textarea:focus,.field select:focus{border-color:#ff1744;box-shadow:0 0 0 2px #ff17441c}.tools input{flex:1;min-width:150px}.field{display:flex;flex-direction:column;gap:6px;margin:12px 0}.field label{font-size:12px;color:#d6c3c9}.field textarea{min-height:90px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.notice{padding:12px;border:1px solid #5a1c2d;background:#1d0a12;border-radius:9px;margin:12px 0}.hidden{display:none!important}.empty{padding:24px;text-align:center;color:var(--muted);border:1px dashed #48202c;border-radius:10px}.toast{display:none;position:fixed;bottom:18px;right:18px;background:#210b13;border:1px solid #a71a3a;border-radius:10px;padding:12px;z-index:99;box-shadow:0 0 22px #ff174422}.toast.show{display:block}footer{text-align:center;color:#9a7e88;font-size:12px;padding:28px;border-top:1px solid #28131b;margin-top:24px}#listingGrid .card,#featured .card{border-color:#3a1723}
@media(max-width:760px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.head{position:static}.hero>.panel:first-child{min-height:unset}.wrap{padding:10px}.title{font-size:21px}}@media(max-width:500px){.wrap{padding:8px}.grid,.grid.two,.row{grid-template-columns:1fr}.hero h1{font-size:39px}.brand{font-size:19px}.nav button{padding:9px 11px}}
 .nav button{display:inline-flex;align-items:center;gap:7px}.nav svg,.title svg,.btn svg{width:16px;height:16px;stroke-width:1.9;vertical-align:middle;flex:0 0 auto}.title svg{color:var(--red);width:21px;height:21px;margin-right:5px}.brand{display:flex;align-items:center;gap:9px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border:1px solid #ff1744;border-radius:9px;color:#ff4265;box-shadow:0 0 16px #ff174433}.brand-mark svg{width:21px;height:21px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px}
/* GXRV Dynasty premium violet dashboard refresh */
:root{--bg:#050612;--p:#0a0d20;--line:#30205d;--txt:#f4f3ff;--muted:#a6a6c6;--red:#d946ef;--red2:#7c3aed;--cyan:#a78bfa;--blue:#4f46e5;--violet:#8b5cf6}
body{background:radial-gradient(ellipse at 12% 0%,#32105c 0,transparent 32%),radial-gradient(ellipse at 88% 15%,#190e47 0,transparent 34%),radial-gradient(ellipse at 60% 80%,#0b1637 0,transparent 40%),#050612;font-family:Inter,"Segoe UI",system-ui,sans-serif;letter-spacing:.05px}
body:before{opacity:.08;background-image:linear-gradient(135deg,transparent 48%,#8b5cf6 49%,transparent 50%);background-size:76px 76px}
.wrap{max-width:1600px;padding:16px}
.head,.panel,.card{background:linear-gradient(145deg,rgba(13,16,39,.96),rgba(6,8,23,.97));border:1px solid #28265b;border-radius:17px;box-shadow:0 12px 32px #0007,inset 0 1px #ffffff08;backdrop-filter:blur(14px)}
.head{position:sticky;top:8px;z-index:20;border-color:#43318a;box-shadow:0 8px 36px #0008,0 0 28px #7c3aed14;padding:14px 18px}
.brand{font-size:23px;letter-spacing:1.2px;text-shadow:0 0 24px #a855f766}.brand small{color:#c4b5fd;letter-spacing:2.4px}.brand-mark{width:42px;height:42px;border-radius:13px;color:#f0abfc;border:1px solid #a855f7;background:linear-gradient(145deg,#43127a,#15112e);box-shadow:0 0 24px #a855f744}.brand-mark svg{width:23px;height:23px}
.btn,nav button{background:linear-gradient(145deg,#141832,#0a0d20);border:1px solid #343366;color:#f5f3ff;border-radius:12px;padding:11px 15px;font-weight:750;transition:transform .18s,border-color .18s,box-shadow .18s;box-shadow:inset 0 1px #ffffff0b}
.btn:hover,nav button:hover{border-color:#c084fc;transform:translateY(-2px);box-shadow:0 7px 24px #9333ea30,0 0 12px #a855f71a}
.btn.primary{background:linear-gradient(110deg,#7c3aed,#c026d3 55%,#6d28d9);border:1px solid #c084fc;color:#fff;box-shadow:0 6px 22px #9333ea44,inset 0 1px #ffffff35}.btn.primary:hover{box-shadow:0 8px 30px #a855f766}
.nav{gap:7px;padding:14px 0;scrollbar-width:thin}.nav button{font-size:12px;padding:10px 13px;white-space:nowrap}.nav button.active{background:linear-gradient(110deg,#6d28d9,#c026d3);border-color:#d8b4fe;box-shadow:0 0 22px #9333ea44}
.hero{grid-template-columns:1.45fr .75fr;gap:16px;margin:16px 0}.hero>.panel:first-child{min-height:320px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 82% 15%,#8b5cf655,transparent 40%),radial-gradient(ellipse at 65% 100%,#c026d333,transparent 50%),linear-gradient(125deg,#11132e,#08091b 70%);border-color:#5940a0}.hero>.panel:first-child:after{content:"✦  ✧  ✦";position:absolute;right:25px;top:22px;color:#d8b4fe;letter-spacing:14px;font-size:22px;text-shadow:0 0 25px #c084fc;opacity:.75}.hero h1{font-size:clamp(39px,5vw,70px);letter-spacing:-2.3px;text-shadow:0 0 30px #8b5cf733}.grad{background:linear-gradient(90deg,#fff,#e879f9 45%,#a78bfa 80%,#67e8f9);background-clip:text;color:transparent}.eyebrow{color:#e879f9;letter-spacing:2.5px}.hero>.panel:nth-child(2){background:radial-gradient(circle at 100% 0,#4c1d95aa,transparent 46%),linear-gradient(145deg,#11132e,#08091b);display:flex;flex-direction:column;justify-content:center}
.title{font-size:clamp(21px,2.5vw,27px);font-weight:850;letter-spacing:-.6px;margin:24px 0 14px}.title svg{color:#d946ef;filter:drop-shadow(0 0 8px #c026d355)}
.grid{gap:14px}.card{padding:15px;transition:transform .18s,border-color .18s,box-shadow .18s}.card:hover{transform:translateY(-3px);border-color:#8b5cf6;box-shadow:0 12px 30px #0008,0 0 22px #7c3aed18}.card:after{width:3px;background:linear-gradient(transparent,#d946ef,#8b5cf6,transparent);opacity:.8}.art{height:112px;border-radius:13px;background:radial-gradient(circle at 50% 20%,#552a91,#17142f 65%,#0b0c20);border:1px solid #463078;text-shadow:0 0 22px #c084fc77}.tag{border:1px solid #7650b5;color:#e9d5ff;background:#251344;border-radius:999px;padding:4px 10px;font-weight:750}.value{color:#e879f9;font-size:16px;text-shadow:0 0 12px #c026d322}
.tools input,.tools select,.field input,.field textarea,.field select{background:#07091a;border:1px solid #302b60;border-radius:11px;color:#f4f3ff;padding:12px 13px}.tools input:focus,.field input:focus,.field textarea:focus,.field select:focus{border-color:#c084fc;box-shadow:0 0 0 3px #a855f71b}.field label{color:#d7d2f4;font-weight:700}.notice{border:1px solid #6740a4;background:linear-gradient(120deg,#21113f,#10112a);border-radius:13px;color:#e9ddff}.empty{border:1px dashed #57418b;border-radius:13px}.toast{background:#17102c;border:1px solid #a855f7;box-shadow:0 0 26px #7c3aed35;border-radius:13px}footer{border-color:#29224d;color:#a5a0ca}
#featured .card,#listingGrid .card{border-color:#49327c}#featured .card .btn{width:100%;margin-top:8px}
/* consistent lucide icon sizing and focus */
.nav svg,.title svg,.btn svg{width:17px;height:17px;stroke-width:2;vertical-align:middle;flex:0 0 auto}.nav button,.btn{gap:8px}.nav button:focus-visible,.btn:focus-visible{outline:2px solid #e879f9;outline-offset:3px}
@media(max-width:900px){.hero{grid-template-columns:1fr}.head{position:relative;top:auto}.nav{padding:10px 0}.hero>.panel:first-child{min-height:260px}}
@media(max-width:600px){.wrap{padding:8px}.head{padding:12px;border-radius:14px}.brand{font-size:19px}.brand-mark{width:36px;height:36px}.hero h1{font-size:39px}.grid,.grid.two,.row{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{padding:11px}.art{height:88px;font-size:42px}.title{font-size:21px}.nav button{padding:9px 11px}.hero>.panel:first-child{min-height:unset}.hero>.panel:first-child:after{font-size:14px;right:12px;top:12px}}
@media(max-width:390px){.grid,.grid.two,.row{grid-template-columns:1fr}.hero h1{font-size:35px}}

</style><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><script src="https://unpkg.com/lucide@latest"></script></head><body><div class="wrap">
<header class="head"><div class="brand" id="ownerBrand" title="Owner access"><span class="brand-mark"><i data-lucide="shield-check"></i></span><span>GXRV DYNASTY<small>BLOX FRUITS • PREMIUM TRADING HUB</small></span></div><div><span id="who" class="tag">Guest</span> <button class="btn primary" id="loginOpen">Login / Register</button><button class="btn hidden" id="logout">Logout</button></div></header>
<nav class="nav" id="nav"><button class="active" data-p="home"><i data-lucide="house"></i> Home</button><button data-p="fruits"><i data-lucide="apple"></i> Fruits</button><button data-p="values"><i data-lucide="gem"></i> Fruit Values</button><button data-p="passes"><i data-lucide="gamepad-2"></i> Gamepasses</button><button data-p="calc"><i data-lucide="scale"></i> Calculator</button><button data-p="listings"><i data-lucide="clipboard-list"></i> Listings</button><button data-p="normal"><i data-lucide="shopping-cart"></i> Normal Stock</button><button data-p="mirage"><i data-lucide="moon-star"></i> Mirage Stock</button><button data-p="chat"><i data-lucide="messages-square"></i> Community Chat</button><button data-p="reports"><i data-lucide="shield-alert"></i> Scam Reports</button><button data-p="profiles"><i data-lucide="user-round"></i> Profiles</button><button data-p="leaderboard"><i data-lucide="trophy"></i> Leaderboard</button><button data-p="inbox"><i data-lucide="bell"></i> Inbox</button><button data-p="history"><i data-lucide="history"></i> Trade History</button><button data-p="admin" id="adminNav" class="hidden"><i data-lucide="shield-check"></i> Admin Panel</button></nav>
<section class="section active" id="s-home"><div class="hero"><div class="panel"><div class="eyebrow">BUILT ON TRUST • UNITED BY POWER</div><h1>Trade smart.<br><span class="grad">Rise together.</span></h1><p class="muted">A premium community trading hub for fruit values, trade offers, gamepasses and safer community trading.</p><div class="actions"><button class="btn primary" data-go="listings">Explore Listings ↗</button><button class="btn" data-go="calc">Calculate a Trade</button></div><div class="grid two"><div class="card"><b id="listingCount">0</b><br><span class="muted">Trade listings</span></div><div class="card"><b>15+ sections</b><br><span class="muted">One trading hub</span></div></div></div><div class="panel"><div style="font-size:40px">🛡️</div><div class="eyebrow">DYNASTY STANDARD</div><h2>Community first.</h2><p class="muted">Clear values, useful trade tools and a dedicated safety centre.</p><div class="notice">Never share your password or account access. Always verify trades in-game.</div><button class="btn" data-go="reports">Safety Centre →</button></div></div><h2 class="title"><i data-lucide="sparkles"></i> Quick Access</h2><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(135px,1fr));margin-bottom:20px"><button class="card" data-go="fruits" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="cherry"></i></div><b>Fruits & Values</b><p class="muted">Browse fruit info</p></button><button class="card" data-go="passes" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="gamepad-2"></i></div><b>Gamepasses</b><p class="muted">Buy • Sell • Trade</p></button><button class="card" data-go="calc" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="scale"></i></div><b>Trade Calculator</b><p class="muted">Compare offers</p></button><button class="card" data-go="listings" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="repeat-2"></i></div><b>Trade Listings</b><p class="muted">Latest offers</p></button><button class="card" data-go="normal" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="boxes"></i></div><b>Normal Stock</b><p class="muted">Check stock board</p></button><button class="card" data-go="mirage" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="moon-star"></i></div><b>Mirage Stock</b><p class="muted">Community updates</p></button><button class="card" data-go="leaderboard" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="trophy"></i></div><b>Leaderboard</b><p class="muted">Community activity</p></button><button class="card" data-go="reports" style="text-align:left;color:inherit;cursor:pointer"><div class="art"><i data-lucide="shield-check"></i></div><b>Safety Centre</b><p class="muted">Report issues</p></button></div><h2 class="title"><i data-lucide="flame"></i> Featured Trade Listings</h2><div id="featured" class="grid"></div></section>
<section class="section" id="s-fruits"><h2 class="title"><i data-lucide="apple"></i> Fruits</h2><div class="tools"><input id="fs" placeholder="Search fruit"><select id="rar"><option>All rarities</option><option>Common</option><option>Uncommon</option><option>Rare</option><option>Legendary</option><option>Mythical</option></select></div><div id="fruitGrid" class="grid"></div></section>
<section class="section" id="s-values"><h2 class="title"><i data-lucide="gem"></i> Fruit Values</h2><p class="muted">Illustrative community estimates, not official values.</p><div class="tools"><input id="vs" placeholder="Search values"></div><div id="valueGrid" class="grid"></div></section>
<section class="section" id="s-passes"><h2 class="title"><i data-lucide="gamepad-2"></i> Gamepasses</h2><div id="passGrid" class="grid"></div></section>
<section class="section" id="s-calc"><h2 class="title"><i data-lucide="scale"></i> W / F / L Calculator</h2><div class="grid two"><div class="panel"><h3>Your Offer</h3><div class="field"><label>Fruit</label><select id="yf"></select></div><div class="field"><label>Quantity</label><input id="yq" type="number" min="1" value="1"></div><p class="value" id="yv"></p></div><div class="panel"><h3>Their Offer</h3><div class="field"><label>Fruit</label><select id="tf"></select></div><div class="field"><label>Quantity</label><input id="tq" type="number" min="1" value="1"></div><p class="value" id="tv"></p></div></div><div class="panel" style="margin-top:12px"><button class="btn primary" id="compare">Compare Trade</button><h2 id="result">Choose items to compare</h2><p class="muted" id="resultText">Values and demand can change.</p></div></section>
<section class="section" id="s-listings"><h2 class="title"><i data-lucide="clipboard-list"></i> Trade Listings</h2><div class="panel"><div class="row"><div class="field"><label>Type</label><select id="lt"><option>Trading</option><option>Buying</option><option>Selling</option></select></div><div class="field"><label>Fruit / item</label><input id="li" placeholder="e.g. Buddha"></div></div><div class="field"><label>Wants</label><input id="lw" placeholder="What do you want?"></div><button class="btn primary" id="addListing">＋ Add Listing</button><p class="muted">Publish offers to the shared marketplace after signing in. Never post passwords, account access, or private information.</p></div><div class="tools"><input id="lsearch" placeholder="Search listings"></div><div id="listingGrid" class="grid"></div></section>
<section class="section" id="s-normal"><h2 class="title"><i data-lucide="shopping-cart"></i> Normal Stock</h2><div class="notice">Separate manual stock board. Verify availability in-game; live stock is not connected yet.</div><div class="grid"><div class="card"><div class="art">🛒</div><h3>Normal Stock Board</h3><span class="tag">Manual updates</span></div></div><div class="panel"><h2>Normal Stock</h2><p class="muted">Community-published updates from the existing Supabase stock table.</p><div id="stock-live-normal" class="list"><div class="muted">Loading stock…</div></div></div></section>
<section class="section" id="s-mirage"><h2 class="title"><i data-lucide="moon-star"></i> Mirage Stock</h2><div class="notice">Dedicated Mirage board. Community sightings should be verified in-game.</div><div class="grid"><div class="card"><div class="art">🌌</div><h3>Mirage Board</h3><span class="tag">Manual updates</span></div></div><div class="panel"><h2>Mirage Stock</h2><p class="muted">Community-published updates from the existing Supabase stock table.</p><div id="stock-live-mirage" class="list"><div class="muted">Loading stock…</div></div></div></section>
<section class="section" id="s-chat"><h2 class="title"><i data-lucide="messages-square"></i> Community Chat</h2><div class="panel"><div id="chatLog" class="empty">Chat preview. Shared real-time chat requires secure database setup.</div><div class="field"><label>Message</label><input id="msg" placeholder="Write a friendly message"></div><button class="btn primary" id="send">Send</button></div></section>
<section class="section" id="s-reports"><h2 class="title"><i data-lucide="shield-alert"></i> Scam Reports</h2><div class="panel"><div class="notice">Do not include passwords, recovery codes or sensitive personal details.</div><div class="field"><label>Reported username / public ID</label><input id="ru"></div><div class="field"><label>Issue</label><select id="rt"><option>Suspected scam</option><option>Harassment / abuse</option><option>Trade dispute</option><option>Other rule violation</option></select></div><div class="field"><label>Details</label><textarea id="rd"></textarea></div><button class="btn primary" id="report">Submit Report</button><p class="muted">Report visibility is controlled by Supabase RLS policies.</p></div></section>
<section class="section" id="s-profiles"><h2 class="title"><i data-lucide="user-round-check"></i> Trader Profiles</h2><div class="grid two"><div class="panel"><div class="field"><label>Search public username / community ID</label><input id="ps" placeholder="Username or public Community ID"></div><button class="btn primary" id="pf">Find Trader</button><div id="pr" style="margin-top:12px"></div></div><div class="panel"><span class="tag">VERIFIED TRADER</span><h3>Request verification</h3><p class="muted">Ask GXRV staff to review your public trading profile. Never submit passwords or private account details.</p><div class="field"><label>Public username</label><input id="vrUsername" placeholder="Your trading username"></div><div class="field"><label>Why should your profile be verified?</label><textarea id="vrReason" maxlength="500" placeholder="Briefly describe your trading history and helpful community activity"></textarea></div><button class="btn primary" id="requestVerification">Send Verification Request</button><div id="vrStatus" class="muted"></div></div></div></section>
<section class="section" id="s-leaderboard"><h2 class="title"><i data-lucide="trophy"></i> GXRV Leaderboard</h2><div class="notice">Community activity board based on active trade listings. It is not a guarantee of trustworthiness or trade safety.</div><div class="panel"><button class="btn primary" id="refreshLeaderboard">Refresh Leaderboard</button><div id="leaderboardList" class="grid" style="margin-top:12px"><div class="muted">Run the add-on SQL setup to load community stats.</div></div></div></section>
<section class="section" id="s-inbox"><h2 class="title"><i data-lucide="bell-ring"></i> Notifications & Inbox</h2><div class="panel"><p class="muted">Private notices for your account, such as report status or community announcements.</p><button class="btn primary" id="refreshInbox">Refresh Inbox</button><div id="inboxList" style="margin-top:12px"><div class="muted">Sign in to view your notifications.</div></div></div></section>
<section class="section" id="s-history"><h2 class="title"><i data-lucide="history"></i> Trade History</h2><div class="panel"><div class="row"><div class="field"><label>Trader</label><input id="ht"></div><div class="field"><label>Date</label><input id="hd" type="date"></div></div><div class="field"><label>Trade summary</label><input id="hs" placeholder="Gave … / received …"></div><button class="btn primary" id="ha">Save Record</button><div id="hl" style="margin-top:12px"></div></div></section>
<section class="section" id="s-admin"><h2 class="title"><i data-lucide="shield-check"></i> Admin Panel</h2><div class="panel"><span class="tag">AUTHORIZED ADMIN ONLY</span><h3>GXRV DYNASTY Moderation</h3><p class="muted">Enter the target member’s Supabase User UID. Jr Mod: up to 12h • Mod: up to 48h • Admin/Owner: temporary + permanent ban and unban. Server-side RPCs enforce limits.</p><div class="notice">These controls affect this website only, not Roblox or Discord. Ban records alone do not suspend Supabase Auth; the app must enforce active bans on sign-in and protected actions.</div><div class="field"><label>Target User UID</label><input id="modUid" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off"></div><div class="row"><div class="field"><label>Action</label><select id="modAction"><option value="temporary">Temporary Ban</option><option value="permanent">Permanent Ban (Admin/Owner)</option><option value="unban">Unban (Admin/Owner)</option></select></div><div class="field"><label>Duration (hours, temporary ban only)</label><input id="modHours" type="number" min="1" max="8760" value="24"></div></div><div class="field"><label>Reason</label><textarea id="modReason" placeholder="Reason for this moderation action"></textarea></div><button class="btn primary" id="applyMod">Apply Action</button><button class="btn" id="refreshMods">Refresh Restrictions</button><h3 class="title">Current Restrictions</h3><div id="modList"><div class="muted">Sign in as authorized staff and load ban history.</div></div><h3 class="title">Scam Reports</h3><p class="muted">Staff must sign in and verify the private staff passcode before reports are loaded.</p><div class="field"><label for="staffPasscode">Staff passcode</label><input id="staffPasscode" type="password" inputmode="numeric" autocomplete="off" placeholder="Enter staff passcode"></div><button class="btn primary" id="refreshReports">Verify &amp; Load Reports</button><div id="reportList" class="muted">Sign in as active staff, enter the passcode, then verify.</div></div></section>
<footer>GXRV DYNASTY • Community-made trading hub • Not affiliated with Roblox or Blox Fruits.<br>Sample values are estimates and may be inaccurate.</footer></div><div id="toast" class="toast"></div>
<div id="modal" style="display:none;position:fixed;inset:0;background:#000c;z-index:20;place-items:center;padding:15px"><div class="panel" style="width:min(430px,100%)"><button class="btn" style="float:right" id="close">✕</button><h2>Login / Register</h2><p class="muted">Sign in or create an account with your email and password.</p><div class="field"><label>Email</label><input type="email" id="email"></div><div class="field"><label>Password</label><input type="password" id="password"></div><button class="btn primary" id="login">Login</button><button class="btn" id="register">Register</button><button class="btn" id="forgot">Forgot password?</button><div id="resetBox" class="hidden"><div class="field"><label>New password</label><input type="password" id="newPassword" minlength="6" autocomplete="new-password"></div><div class="field"><label>Confirm new password</label><input type="password" id="confirmPassword" minlength="6" autocomplete="new-password"></div><button class="btn primary" id="savePassword">Save New Password</button></div><p class="muted">Email confirmation is controlled by your Supabase project settings.</p></div></div>
<script>
const F=[["Rocket","Common","🚀",5000],["Spin","Common","🌀",7500],["Blade","Common","🗡️",30000],["Spring","Common","🌱",60000],["Bomb","Common","💣",80000],["Smoke","Common","💨",100000],["Flame","Uncommon","🔥",250000],["Ice","Uncommon","❄️",350000],["Sand","Uncommon","🏜️",420000],["Dark","Uncommon","🌑",500000],["Light","Rare","✨",800000],["Magma","Rare","🌋",1100000],["Quake","Rare","🌊",1000000],["Buddha","Legendary","🙏",1200000],["Portal","Legendary","🌀",2000000],["Rumble","Legendary","⚡",2100000],["Blizzard","Legendary","🌨️",2200000],["Dough","Mythical","🍩",2800000],["Shadow","Mythical","🌘",2900000],["Venom","Mythical","☠️",3000000],["Control","Mythical","🎛️",3200000],["Spirit","Mythical","👻",3400000],["Leopard","Mythical","🐆",5000000],["Yeti","Mythical","❄️",6000000],["Kitsune","Mythical","🦊",8000000],["Dragon","Mythical","🐉",9000000]];
const P=[["2x Money","💰","4.5M"],["2x Mastery","⚔️","3.5M"],["Fast Boats","🚤","1.5M"],["Fruit Notifier","🔔","9M"],["+1 Fruit Storage","📦","4.5M"],["2x Boss Drops","👑","2.5M"]];
const $=x=>document.getElementById(x), esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])), nfmt=n=>Number(n).toLocaleString("en-US");let offers=[],chats=[],hist=[];
function refreshIcons(){if(window.lucide&&typeof window.lucide.createIcons==="function")window.lucide.createIcons();}
window.addEventListener("DOMContentLoaded",refreshIcons);
function go(p){document.querySelectorAll(".section").forEach(s=>s.classList.toggle("active",s.id==="s-"+p));document.querySelectorAll("[data-p]").forEach(b=>b.classList.toggle("active",b.dataset.p===p));scrollTo({top:0,behavior:"smooth"});refreshIcons()}
document.querySelectorAll("[data-p]").forEach(b=>b.onclick=()=>go(b.dataset.p));document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>go(b.dataset.go));
function fruitCard(f){return `<article class="card"><div class="art">${f[2]}</div><h3>${f[0]}</h3><span class="tag">${f[1]}</span><p class="value">Est. ${nfmt(f[3])}</p><small class="muted">Community estimate</small></article>`}
function drawF(){let q=$("fs").value.toLowerCase(),r=$("rar").value;$("fruitGrid").innerHTML=F.filter(f=>f[0].toLowerCase().includes(q)&&(r==="All rarities"||f[1]===r)).map(fruitCard).join("")||'<div class="empty">No fruit found.</div>'}
function drawV(){let q=$("vs").value.toLowerCase();$("valueGrid").innerHTML=F.filter(f=>f[0].toLowerCase().includes(q)).map(f=>`<article class="card"><div class="art">${f[2]}</div><h3>${f[0]}</h3><span class="tag">${f[1]}</span><p>Physical: <b class="value">${nfmt(f[3])}</b></p><p>Permanent: <b class="value">${nfmt(f[3]*100)}</b></p><small class="muted">Illustrative estimate only</small></article>`).join("")}
$("passGrid").innerHTML=P.map(p=>`<article class="card"><div class="art">${p[1]}</div><h3>${p[0]}</h3><p class="value">Est. ${p[2]}</p><span class="tag">Gamepass</span></article>`).join("");
function drawL(){let q=$("lsearch").value.toLowerCase(),a=offers.filter(o=>(o.item+" "+o.want).toLowerCase().includes(q));$("listingGrid").innerHTML=a.map(o=>`<article class="card"><div class="art">🤝</div><h3>${esc(o.item)}</h3><span class="tag">${esc(o.type)}</span><p>Wants: ${esc(o.want||"Offers")}</p></article>`).join("")||'<div class="empty">No listings yet. Add an offer above.</div>';$("featured").innerHTML=offers.slice(0,3).map(o=>`<article class="card"><div class="art">🤝</div><h3>${esc(o.item)}</h3><span class="tag">${esc(o.type)}</span><p>${esc(o.want||"Offers")}</p></article>`).join("")||'<div class="empty">Featured member offers will appear here.</div>';$("listingCount").textContent=offers.length}
$("addListing").onclick=()=>{if(!$("li").value.trim())return notify("Enter an item.");offers.unshift({type:$("lt").value,item:$("li").value.trim(),want:$("lw").value.trim()});$("li").value=$("lw").value="";drawL();notify("Added to this preview session.")};$("lsearch").oninput=drawL;
["fs","rar"].forEach(i=>$(i).oninput=drawF);$("vs").oninput=drawV;
["yf","tf"].forEach(id=>$(id).innerHTML=F.map(f=>`<option value="${f[0]}">${f[0]}</option>`).join(""));
function compare(){let a=F.find(f=>f[0]===$("yf").value)[3]*Math.max(1,+$("yq").value),b=F.find(f=>f[0]===$("tf").value)[3]*Math.max(1,+$("tq").value);$("yv").textContent="Value: "+nfmt(a);$("tv").textContent="Value: "+nfmt(b);let d=Math.abs(a-b)/Math.max(a,b)*100;$("result").textContent=d<5?"⚖️ Fair by estimate":b>a?"📈 Win by estimate":"📉 Loss by estimate";$("resultText").textContent="Estimated difference "+d.toFixed(1)+"%. Demand may change the outcome."}["yf","tf","yq","tq"].forEach(id=>$(id).onchange=compare);$("compare").onclick=compare;compare();
$("send").onclick=()=>{let m=$("msg").value.trim();if(!m)return;chats.push(m);$("chatLog").className="";$("chatLog").innerHTML=chats.map(x=>"<p>💬 "+esc(x)+"</p>").join("");$("msg").value=""};
$("report").onclick=()=>notify("Report form preview only; secure delivery is not connected.");$("pf").onclick=()=>{$("pr").innerHTML='<div class="empty">Profile search needs database connection.</div>'};
$("ha").onclick=()=>{if(!$("ht").value.trim()||!$("hs").value.trim())return notify("Enter trader and trade summary.");hist.unshift({t:$("ht").value,s:$("hs").value,d:$("hd").value});$("hl").innerHTML=hist.map(h=>`<div class="card"><b>${esc(h.t)}</b><p>${esc(h.s)}</p><small>${esc(h.d||"Date not set")}</small></div>`).join("")};
const SUPABASE_URL='https://wlpfdwobntppmdlkapfu.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_H4BqE-74deolLV6_pkgzpA_pLJJbkXy';
const sb=window.supabase?.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);
let currentUser=null, isAdmin=false, currentRole=null; window.gxrvOwnerSession=false; window.gxrvIsAuthorizedOwner=false;
$("loginOpen").onclick=()=>{$("modal").style.display="grid"};$("close").onclick=()=>{$("modal").style.display="none"};
async function syncAuth(){
 if(!sb){$("who").textContent="Supabase library failed to load";return;}
 const {data}=await sb.auth.getSession(); currentUser=data?.session?.user||null;window.currentUser=currentUser;isAdmin=false;currentRole=null;window.gxrvOwnerSession=!!currentUser;window.gxrvIsAuthorizedOwner=false;
 if(currentUser){
   const {data:row,error}=await sb.from('gxrv_admins').select('user_id,role,active').eq('user_id',currentUser.id).maybeSingle();
   currentRole=(!error&&row?.active!==false)?(row?.role||null):null;
   isAdmin=!!currentRole;window.gxrvIsAuthorizedOwner=currentRole==='owner';
   $("who").textContent=(currentUser.email||"Signed in")+(currentRole?" • "+currentRole.toUpperCase():"");
   $("adminNav").classList.toggle("hidden",!isAdmin);
   if(!isAdmin) $("s-admin").innerHTML='<div class="panel"><h2>Staff access required</h2><p class="muted">This account is not assigned an active staff role.</p></div>';
   else { const hours=$("modHours"); if(hours){hours.max=currentRole==='jr_mod'?12:currentRole==='mod'?48:8760;hours.value=Math.min(Number(hours.value)||12,Number(hours.max));} }
 }else{$("who").textContent="Guest";$("adminNav").classList.add("hidden");$("s-admin").innerHTML='<div class="panel"><h2>Staff access required</h2><p class="muted">Sign in with an authorized staff account.</p></div>';}
 $("loginOpen").classList.toggle("hidden",!!currentUser);$("logout").classList.toggle("hidden",!currentUser);
 if(currentUser){const {data:bans}=await sb.from('gxrv_bans').select('reason,ban_type,expires_at,active').eq('user_id',currentUser.id).eq('active',true).order('created_at',{ascending:false}).limit(1);const b=bans?.[0];if(b&&(b.ban_type==='permanent'||!b.expires_at||new Date(b.expires_at)>new Date())){await sb.auth.signOut();currentUser=null;window.currentUser=null;notify('Access blocked: '+(b.reason||'Active ban'));$("who").textContent='Restricted account';$("loginOpen").classList.remove('hidden');$("logout").classList.add('hidden');}}
 if(isAdmin) await loadModerationList();
}
$("login").onclick=async()=>{
  if(!sb)return notify("Supabase library unavailable. Check connection.");
  const email=$("email").value.trim(),password=$("password").value;
  if(!email||!password)return notify("Enter email and password.");
  const {error}=await sb.auth.signInWithPassword({email,password});
  if(error)return notify("Login failed: "+error.message);
  await syncAuth();$("modal").style.display="none";notify(isAdmin?"Admin login successful.":"Login successful.");
};
$("register").onclick=async()=>{
  if(!sb)return notify("Supabase library unavailable. Check connection.");
  const email=$("email").value.trim(),password=$("password").value;
  if(!email||!password)return notify("Enter email and password.");
  if(password.length<6)return notify("Password must be at least 6 characters.");
  const {data,error}=await sb.auth.signUp({email,password});
  if(error)return notify("Registration failed: "+error.message);
  if(data.session){await syncAuth();notify("Account created.");}
  else notify("Account created, but no session was returned. Check Supabase email confirmation settings.");
};
$("logout").onclick=async()=>{if(sb)await sb.auth.signOut();await syncAuth();go("home");notify("Logged out.")};
function notify(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),3500)}
if(sb){syncAuth();loadExistingStock();sb.auth.onAuthStateChange(()=>setTimeout(()=>{syncAuth();loadExistingStock()},0));}
else $("who").textContent="Supabase CDN unavailable";

async function loadExistingStock(){
  if(!sb)return;
  for(const type of ['normal','mirage']){
    const el=$('stock-live-'+type);if(!el)continue;
    const {data,error}=await sb.from('gxrv_stock').select('stock_type,fruits,note,updated_at').eq('stock_type',type).order('updated_at',{ascending:false}).limit(1);
    if(error){el.innerHTML='<div class="muted">Stock table not available yet. Existing database data has not been changed.</div>';continue}
    const row=data?.[0];
    el.innerHTML=row?`<div class="card"><div class="tags">${(row.fruits||[]).map(f=>`<span class="tag">${esc(f)}</span>`).join(' ')||'No fruits listed'}</div><p>${esc(row.note||'Community update')}</p><small class="muted">Updated ${new Date(row.updated_at).toLocaleString()}</small></div>`:'<div class="muted">No stock update published yet.</div>';
  }
}
async function loadModerationList(){
 if(!sb||!isAdmin)return;const el=$("modList");if(!el)return;
 const {data,error}=await sb.from('gxrv_bans').select('id,user_id,reason,ban_type,starts_at,expires_at,active,created_by,created_at').order('created_at',{ascending:false}).limit(100);
 if(error){el.innerHTML='<div class="notice">Ban history is not readable yet. Add reviewed SELECT RLS policies for authorized staff.</div>';return;}
 el.innerHTML=(data||[]).map(r=>`<div class="card" style="margin:8px 0"><b>${esc(r.ban_type)} • ${r.active?'ACTIVE':'INACTIVE'}</b><p class="muted" style="overflow-wrap:anywhere">UID: ${esc(r.user_id)}</p><p>${esc(r.reason||'No reason supplied')}</p><small class="muted">${r.expires_at?'Expires: '+esc(new Date(r.expires_at).toLocaleString()):'No expiry'} • ${esc(new Date(r.created_at).toLocaleString())}</small></div>`).join('')||'<div class="empty">No ban records.</div>';
}
if($("applyMod"))$("applyMod").onclick=async()=>{
 if(!sb||!isAdmin)return notify('Staff access required.');const uid=$("modUid").value.trim(),action=$("modAction").value,reason=$("modReason").value.trim();
 if(!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(uid))return notify('Enter a valid Supabase User UID.');
 if(uid===currentUser.id)return notify('You cannot ban your own account.');if(action!=='unban'&&!reason)return notify('Enter a reason.');
 let result;
 if(action==='unban'){
   if(!['admin','owner'].includes(currentRole))return notify('Only Admin/Owner can unban.');
   result=await sb.rpc('gxrv_unban_user',{p_user_id:uid});
 }else{
   const permanent=action==='permanent';if(permanent&&!['admin','owner'].includes(currentRole))return notify('Only Admin/Owner can issue permanent bans.');
   let duration=null;if(!permanent){duration=Number($("modHours").value);const max=currentRole==='jr_mod'?12:currentRole==='mod'?48:8760;if(!Number.isInteger(duration)||duration<1||duration>max)return notify('Your role limit is '+max+' hours.');}
   result=await sb.rpc('gxrv_issue_ban',{p_user_id:uid,p_reason:reason,p_duration_hours:duration,p_permanent:permanent});
 }
 if(result.error)return notify('Action failed: '+result.error.message);notify(action==='unban'?'Unban request completed.':'Ban saved.');await loadModerationList();
};
if($("refreshMods"))$("refreshMods").onclick=loadModerationList;
async function loadReports(){
 const el=$("reportList");
 if(!sb)return notify('Supabase unavailable.');
 if(!currentUser)return notify('Sign in with your staff account first.');
 if(!currentRole)return notify('This account has no active staff role.');
 const passcode=$("staffPasscode")?.value||'';
 if(!passcode.trim())return notify('Enter the staff passcode.');
 el.innerHTML='<div class="muted">Verifying staff access…</div>';
 const {data,error}=await sb.rpc('gxrv_get_reports',{p_key:passcode});
 if(error){el.innerHTML='<div class="notice">Could not load reports: '+esc(error.message)+'. Check that the secure reports SQL has been run.</div>';return;}
 if(!Array.isArray(data)){el.innerHTML='<div class="notice">No report data returned.</div>';return;}
 el.innerHTML=data.map(r=>`<div class="card" style="margin:8px 0"><b>#${r.id} • ${esc(r.status)}</b><p>Reported: ${esc(r.reported_username)} • ${esc(r.category)}</p><p>${esc(r.details)}</p><small class="muted">${esc(new Date(r.created_at).toLocaleString())}</small></div>`).join('')||'<div class="empty">No reports submitted.</div>';
 notify('Staff passcode verified. Reports loaded.');
}
if($("refreshReports"))$("refreshReports").onclick=loadReports;
/* Front-end admin visibility is only a convenience. Enforce admin permissions with Supabase RLS policies too.
   Never place a service-role/secret key in a public HTML file. */
// Supabase-backed community features. These use additive gxrv_* tables created by the companion SQL.
async function requireLogin(){if(!currentUser){notify('Please sign in first.');$('modal').style.display='grid';return false;}return true;}
async function loadListings(){if(!sb)return;const {data,error}=await sb.from('gxrv_trade_listings').select('id,user_id,listing_type,item,wants,created_at').eq('is_active',true).order('created_at',{ascending:false}).limit(100);if(error){notify('Listings table not ready. Run the companion SQL setup.');return;}offers=(data||[]).map(r=>({id:r.id,type:r.listing_type,item:r.item,want:r.wants||'',user_id:r.user_id}));drawL();}
$('addListing').onclick=async()=>{if(!await requireLogin())return;const item=$('li').value.trim(),wants=$('lw').value.trim();if(!item)return notify('Enter an item.');const {error}=await sb.from('gxrv_trade_listings').insert({user_id:currentUser.id,listing_type:$('lt').value,item,wants});if(error)return notify('Could not save listing: '+error.message);$('li').value=$('lw').value='';await loadListings();notify('Listing published.');};
async function loadChat(){if(!sb)return;const {data,error}=await sb.from('gxrv_chat_messages').select('id,user_id,display_name,message,created_at').order('created_at',{ascending:true}).limit(100);if(error){$('chatLog').textContent='Chat database setup is needed. Run the companion SQL setup.';return;} $('chatLog').className='';$('chatLog').innerHTML=(data||[]).map(r=>`<p><b>${esc(r.display_name||'Member')}</b>: ${esc(r.message)} <small class="muted">${new Date(r.created_at).toLocaleString()}</small></p>`).join('')||'<div class="empty">No messages yet.</div>';}
$('send').onclick=async()=>{if(!await requireLogin())return;const message=$('msg').value.trim();if(!message)return;const {error}=await sb.from('gxrv_chat_messages').insert({user_id:currentUser.id,display_name:currentUser.user_metadata?.username||currentUser.email?.split('@')[0]||'Member',message});if(error)return notify('Could not send message: '+error.message);$('msg').value='';await loadChat();};
$('report').onclick=async()=>{if(!await requireLogin())return;const reported=$('ru').value.trim(),kind=$('rt').value,details=$('rd').value.trim();if(!reported||!details)return notify('Add a reported username and details.');const {error}=await sb.from('gxrv_reports').insert({reporter_id:currentUser.id,reported_username:reported,category:kind,details,status:'open'});if(error)return notify('Could not submit report: '+error.message);$('ru').value=$('rd').value='';notify('Report submitted securely.');};
$('pf').onclick=async()=>{const q=$('ps').value.trim();if(!q)return notify('Enter a username or Community ID.');const {data,error}=await sb.from('profiles').select('username,community_id,trusted').or(`username.ilike.%${q.replace(/[,%()]/g,'')}%,community_id.eq.${q}`).limit(10);if(error){$('pr').innerHTML='<div class="notice">Profile lookup unavailable. Check the existing profiles table and its RLS permissions.</div>';return;} $('pr').innerHTML=(data||[]).map(x=>`<div class="card"><b>${esc(x.username||'Member')}</b> ${x.trusted?'<span class="tag">✓ VERIFIED</span>':''}<p>Community ID: ${esc(x.community_id||'—')}</p></div>`).join('')||'<div class="empty">No matching public profile.</div>';};
$('ha').onclick=async()=>{if(!await requireLogin())return;const trader=$('ht').value.trim(),summary=$('hs').value.trim(),date=$('hd').value||null;if(!trader||!summary)return notify('Enter trader and trade summary.');const {error}=await sb.from('gxrv_trade_history').insert({user_id:currentUser.id,trader,summary,trade_date:date});if(error)return notify('Could not save history: '+error.message);notify('Trade history saved.');await loadHistory();};
async function loadHistory(){if(!sb||!currentUser)return;const {data,error}=await sb.from('gxrv_trade_history').select('trader,summary,trade_date,created_at').eq('user_id',currentUser.id).order('created_at',{ascending:false}).limit(50);if(error){$('hl').innerHTML='<div class="muted">Trade history table setup required.</div>';return;} $('hl').innerHTML=(data||[]).map(h=>`<div class="card"><b>${esc(h.trader)}</b><p>${esc(h.summary)}</p><small>${esc(h.trade_date||h.created_at?.slice(0,10)||'')}</small></div>`).join('')||'<div class="empty">No saved trade history.</div>';}

// GXRV Dynasty add-ons: verification requests, leaderboard and private inbox.
if($("requestVerification"))$("requestVerification").onclick=async()=>{
 if(!await requireLogin())return;
 const username=$("vrUsername").value.trim(),reason=$("vrReason").value.trim();
 if(!username||!reason)return notify('Enter your public username and a short reason.');
 const {error}=await sb.from('gxrv_verification_requests').insert({user_id:currentUser.id,username,reason});
 if(error)return notify('Could not submit request: '+error.message+' (run the add-on SQL setup first).');
 $("vrUsername").value=$("vrReason").value='';
 $("vrStatus").textContent='Request submitted. Staff review is required; verification is not automatic.';
 notify('Verification request submitted.');
};
async function loadLeaderboard(){
 const el=$("leaderboardList"); if(!el)return;
 if(!sb){el.innerHTML='<div class="notice">Supabase unavailable.</div>';return;}
 const {data,error}=await sb.rpc('gxrv_get_leaderboard');
 if(error){el.innerHTML='<div class="notice">Leaderboard setup required. Run the GXRV add-on SQL file. '+esc(error.message)+'</div>';return;}
 el.innerHTML=(data||[]).map((r,i)=>`<article class="card"><div class="art">${i===0?'🥇':i===1?'🥈':i===2?'🥉':'🏆'}</div><h3>${esc(r.username||'Member')}</h3><span class="tag">${r.trusted?'✓ Verified profile':'Community Trader'}</span><p><b class="value">${Number(r.active_listings||0)}</b> active listings</p></article>`).join('')||'<div class="empty">No public trading activity yet.</div>';
}
if($("refreshLeaderboard"))$("refreshLeaderboard").onclick=loadLeaderboard;
async function loadInbox(){
 const el=$("inboxList");if(!el)return;
 if(!sb||!currentUser){el.innerHTML='<div class="notice">Sign in to view your private inbox.</div>';return;}
 const {data,error}=await sb.from('gxrv_notifications').select('id,title,body,created_at,is_read').eq('user_id',currentUser.id).order('created_at',{ascending:false}).limit(50);
 if(error){el.innerHTML='<div class="notice">Inbox setup required. Run the GXRV add-on SQL file. '+esc(error.message)+'</div>';return;}
 el.innerHTML=(data||[]).map(n=>`<article class="card" style="margin:8px 0"><div class="row"><b>${esc(n.title)}</b><small class="muted">${esc(new Date(n.created_at).toLocaleString())}</small></div><p>${esc(n.body)}</p><span class="tag">${n.is_read?'Read':'New'}</span>${n.is_read?'':` <button class="btn" data-read="${n.id}">Mark read</button>`}</article>`).join('')||'<div class="empty">No notifications yet.</div>';
 el.querySelectorAll('[data-read]').forEach(b=>b.onclick=async()=>{const {error}=await sb.from('gxrv_notifications').update({is_read:true}).eq('id',Number(b.dataset.read)).eq('user_id',currentUser.id);if(error)return notify('Could not mark read: '+error.message);await loadInbox();});
}
if($("refreshInbox"))$("refreshInbox").onclick=loadInbox;
$('forgot').onclick=async()=>{if(!sb)return notify('Supabase unavailable.');const email=$('email').value.trim();if(!email)return notify('Enter your account email first.');const redirectTo=location.origin+location.pathname;const {error}=await sb.auth.resetPasswordForEmail(email,{redirectTo});if(error)return notify('Reset request failed: '+error.message);notify('If the account exists, a reset email has been sent.');};
function showRecovery(){const h=location.hash||'';if(h.includes('type=recovery')||h.includes('access_token=')){ $('modal').style.display='grid';$('resetBox').classList.remove('hidden');notify('Recovery link detected. Enter your new password.');}}
$('savePassword').onclick=async()=>{const a=$('newPassword').value,b=$('confirmPassword').value;if(a.length<6)return notify('Password must be at least 6 characters.');if(a!==b)return notify('Passwords do not match.');const {error}=await sb.auth.updateUser({password:a});if(error)return notify('Password update failed: '+error.message);history.replaceState(null,'',location.pathname+location.search);$('resetBox').classList.add('hidden');$('newPassword').value=$('confirmPassword').value='';notify('Password updated. You can now sign in.');};
if(sb){sb.auth.onAuthStateChange((event,session)=>{if(['SIGNED_IN','SIGNED_OUT','USER_UPDATED','PASSWORD_RECOVERY','INITIAL_SESSION'].includes(event))setTimeout(async()=>{await syncAuth();await loadListings();await loadChat();await loadHistory();await loadInbox();await loadLeaderboard();showRecovery();},0);});}
setTimeout(()=>{loadListings();loadChat();loadInbox();loadLeaderboard();showRecovery();},500);
</script>
<script>
// Owner entry gesture: tap the brand 5 times, then enter the owner code.
// Important: a code stored in client-side HTML is discoverable; Supabase authorization remains required.
(()=>{
 const OWNER_CODE='1442011'; let taps=0, resetTap;
 const brand=document.getElementById('ownerBrand');
 if(!brand) return;
 brand.style.cursor='default';
 brand.addEventListener('click',()=>{
   taps++; clearTimeout(resetTap); resetTap=setTimeout(()=>taps=0,2200);
   if(taps>=5){ taps=0;
     const entered=prompt('GXRV DYNASTY Owner Access Code');
     if(entered!==OWNER_CODE){ alert('Incorrect owner code.'); return; }
     if(!window.currentUser && !window.gxrvOwnerSession){ alert('Please sign in with the authorized owner account first.'); return; }
     if(!window.gxrvIsAuthorizedOwner){ alert('Code accepted, but the signed-in account is not verified as an authorized owner.'); return; }
     const nav=document.getElementById('adminNav');
     if(nav){ nav.classList.remove('hidden'); nav.click(); }
   }
 });
})();
</script>

</body></html>
